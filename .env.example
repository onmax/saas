# Public URL (required for OAuth callbacks + links in emails)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth (required, min 32 chars)
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# GitHub OAuth (required if you keep GitHub sign-in enabled)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend (required for verification + password reset emails)
RESEND_API_KEY=
RESEND_FROM="Your App <no-reply@example.com>"

# Polar (required for billing)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Polar environment (optional)
# - production: https://api.polar.sh
# - sandbox: https://sandbox-api.polar.sh
POLAR_SERVER=sandbox

# Polar product IDs (each product should have monthly + yearly prices in Polar)
POLAR_PRODUCT_BASIC_ID=
POLAR_PRODUCT_STANDARD_ID=
POLAR_PRODUCT_PREMIUM_ID=
